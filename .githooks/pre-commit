#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Block commits that would fail CI `cargo fmt --check` on Ubuntu.
set -e
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)"
if [ -z "$staged" ]; then
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not on PATH; cannot rustfmt. CI will still check."
  exit 0
fi

if cargo fmt --all -- --check; then
  exit 0
fi

cargo fmt --all
echo "pre-commit: rustfmt rewrote Rust files. Stage them and commit again."
exit 1
