+    // wcr: the highest sample (dBFS) and the share of samples at full scale
+    // (percent) in about the newest window_ms of capture. False while the
+    // capture is down or has not delivered audio for 250 ms.
+    bool capture_peak_stats(int window_ms, float& peak_db, float& clip_pct) {
+        if (!capture_open_.load(std::memory_order_acquire)) return false;
+        if (steady_ms() - last_block_ms_.load(std::memory_order_relaxed) > 250)
+            return false;
+        uint64_t seq = block_seq_.load(std::memory_order_acquire);
+        if (seq == 0) return false;
+        uint64_t need = (uint64_t)sample_rate_ * window_ms / 1000;
+        uint64_t frames = 0, clipped = 0;
+        float peak = 0.0f;
+        uint64_t count = seq < LEVEL_RING ? seq : LEVEL_RING;
+        for (uint64_t k = 1; k <= count; k++) {
+            uint64_t idx = (seq - k) % LEVEL_RING;
+            frames += block_frames_[idx].load(std::memory_order_relaxed);
+            clipped += block_clipped_[idx].load(std::memory_order_relaxed);
+            peak = std::max(peak, block_peak_[idx].load(std::memory_order_relaxed));
+            if (frames >= need) break;
+        }
+        if (frames == 0) return false;
+        peak_db = peak < 1e-5f ? -100.0f : 20.0f * std::log10(peak);
+        clip_pct = 100.0f * (float)clipped / (float)frames;
+        return true;
+    }
