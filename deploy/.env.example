WCR_DOMAIN=weechatradio.com
# Optional: postgres (v1 uses SQLite in /data)
# POSTGRES_PASSWORD=change-me
# Hub only. Real values stay in /opt/wcr/.env on the droplet, never in git.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# Optional: the most mail the hub sends through Resend in a day (default 1000).
# Keep it below the Resend plan's daily quota.
# WCR_MAIL_DAILY_CAP=1000
