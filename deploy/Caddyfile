{
	email admin@weechatradio.com
}

weechatradio.com, www.weechatradio.com {
  encode gzip
  handle /api/path* {
    reverse_proxy path:7380
  }
  handle {
    root * /srv/web
    # Pages always revalidate, so a browser never shows an old guide after a
    # deploy. Scripts, styles and images carry a version in their URL.
    @page path / *.html
    header @page Cache-Control "no-cache"
    file_server
    try_files {path} /index.html
  }
}

hub.weechatradio.com, api.weechatradio.com {
  encode gzip
  reverse_proxy hub:7373 {
    header_up X-Forwarded-For {remote_host}
  }
  @ws {
    header Connection *Upgrade*
    header Upgrade websocket
  }
  reverse_proxy @ws hub:7373 {
    header_up X-Forwarded-For {remote_host}
  }
}
